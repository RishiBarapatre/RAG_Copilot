.pytest_cache/
htmlcov/
.coverage
*.coveragerc
coverage.xml

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

